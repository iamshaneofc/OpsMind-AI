# =============================================================================
# OpsMind AI — Environment Variables
# =============================================================================
# Copy to ".env" and fill in real values (never commit .env).
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# =============================================================================

# --- Required: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Required: Database ---
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# --- Required: OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# --- Required: Application ---
NODE_ENV=production
PORT=3000

# --- Optional: Seed/Demo Passwords ---
# SEED_PASSWORD=changeme

# --- Optional: Demo Login Buttons (set to hide in production) ---
# NEXT_PUBLIC_DEMO_EMAIL_MANAGER=manager@opsmind.ai
# NEXT_PUBLIC_DEMO_EMAIL_ANALYST=analyst@opsmind.ai
# NEXT_PUBLIC_DEMO_PASSWORD=password123

# --- Optional: Feature Flags ---
# SKIP_ERP_MANUAL_ALLOCATION=false
# SKIP_ERP_STATUS_JOURNAL=false
# SKIP_ERP_PREDICTIONS_CACHE=false
# FACTORY_STALE_ESCALATION_DAYS=14

# --- Optional: Testing ---
# CHAT_TEST_PASSWORD=your_test_user_password
# CHAT_TEST_EMAIL=distributor@opsmindchemicals.com
# CHAT_API_BEARER_TOKEN=
# APP_BASE_URL=http://localhost:3000
# LOG_ERP_SQL=1

# --- Optional: Local Development Migration ---
# LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
